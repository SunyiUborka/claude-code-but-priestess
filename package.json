{
  "name": "priestess-arknights",
  "version": "0.6.5",
  "description": "A cross-platform tray companion that lets you chat with 普瑞赛斯, backed by local Claude Code or Codex CLI usage.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-electron.js",
    "start": "node scripts/run-electron.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "lint": "node scripts/check-assets.js"
  },
  "keywords": [
    "tray",
    "electron",
    "linux",
    "claude-code",
    "codex"
  ],
  "author": "aklnaaw <aklnaaww@gmail.com>",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "local.priestess-arknights.menubar",
    "productName": "priestess-arknights",
    "publish": [
      {
        "provider": "github",
        "owner": "aklnaaw",
        "repo": "priestess-arknights"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/.DS_Store",
      "package.json"
    ],
    "asarUnpack": [
      "assets/**"
    ],
    "directories": {
      "buildResources": "assets/build"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "assets/character/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/character/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
